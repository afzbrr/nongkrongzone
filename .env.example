# Supabase configuration (set these in AI Studio Secrets or Vercel Environment Variables)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional client-side Supabase Realtime keys (non-secret anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Telegram Bot Token for verifying Telegram Mini App initData signatures
TELEGRAM_BOT_TOKEN=
